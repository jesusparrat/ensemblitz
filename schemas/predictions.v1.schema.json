          }
        }
      }
    },
    "explanation": {
      "type": "object",
      "description": "Optional pre-computed model diagnostics and descriptive matchups (added in PR 5; backward compatible with existing v1 snapshots lacking this field).",
      "additionalProperties": false,
      "required": [
